# ===========================================================================
# GEO-analytics 環境変数サンプル（見本・公開対象）
# ⚠️ このファイルには絶対に実値を書かないこと。実値は `.env`（gitignore済み）へ。
# 使い方: このファイルを `.env` にコピーし、各値を埋める。
# ===========================================================================

# --- データベース（共通） ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geo_analytics

# --- Flyway（マイグレーション実行ユーザー = postgres 等の権限保持者） ---
FLYWAY_USER=postgres
FLYWAY_PASSWORD=

# --- アプリ用DBロール（RLS適用ワーカー） ---
# パスワードは強いランダム値を必須で設定する（未設定だと起動時にDB接続で失敗）。
# 生成例(bash): openssl rand -base64 24
API_WORKER_USER=api_worker
API_WORKER_PASSWORD=
BATCH_WORKER_USER=batch_worker
BATCH_WORKER_PASSWORD=

# --- 本番(prod)プロファイル用 ---
DB_USER=postgres
DB_PASSWORD=

# --- 認証 / JWT ---
# 256bit 以上のランダム値を必須で設定する（未設定だと起動時にトークン生成で失敗）。
# 生成例(PowerShell): $b=New-Object byte[] 64; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); ([BitConverter]::ToString($b) -replace '-','').ToLower()
# 生成例(bash):       openssl rand -hex 64
JWT_SECRET=

# --- AI / 外部API ---
# Google Gemini APIキー。Google Cloud で発行。
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
# SerpAPI（競合エビデンス取得）
SERPAPI_API_KEY=
# Google Places API
GOOGLE_PLACES_API_KEY=

# --- Redis（crawler キャッシュ。redis-enabled=false の間は不要） ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- その他 ---
APP_PDF_TEMP_DIR=./data/pdf-temp

# --- メール送信（ログインコード・監査完了通知） ---
# 開発: MAIL_* を書かなければ、開発用の受信箱 Mailpit（bash scripts/mail.sh up → http://localhost:8025）へ送る。
#       ⚠️ 「MAIL_HOST=」のように空で書くと空文字が入り起動しない。使わない行はコメントのままにする。
# Gmail で実際に送る場合（手順は docs/DEVELOPMENT_SETUP.md）: 下の4行のコメントを外し、
#       MAIL_USERNAME に自分の Gmail、MAIL_PASSWORD に Google アカウントで発行した「アプリパスワード」（機密）を入れる。
#       APP_NOTIFICATIONS_MAIL_FROM も同じ Gmail にする（違うと Gmail 側で送信元を書き換えられる）。
# 本番: MAIL_HOST 等は必須。未設定だと起動しない（docs/DEPLOYMENT_ENV.md）。
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
APP_NOTIFICATIONS_MAIL_FROM=noreply@example.com

# --- 開発用の初期ユーザー ---
# アプリ起動時に作る管理者のメールアドレス（開発プロファイルのみ）。未指定なら bootstrap@example.com。
# 自分の Gmail にログインコードを届けたいときに指定する（例: 自分+dev@gmail.com）。
# APP_BOOTSTRAP_EMAIL=

# --- Stripe 決済（セルフサーブ自動決済・案B） ---
# テストモードのシークレットキー（Stripeダッシュボード → 開発者 → APIキー）。機密。
STRIPE_SECRET_KEY=
# Webhook署名シークレット（`stripe listen` 起動時に表示される whsec_...）。機密。
STRIPE_WEBHOOK_SECRET=
# プラン別の価格ID（Stripeで月額Priceを作成して設定。機密ではない）
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
STRIPE_PRICE_EXPERT=
# 任意: 決済完了/キャンセル後の戻り先URL（未設定なら application.yml の既定値）
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
